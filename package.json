{
  "name": "ai-streaming-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight AI streaming runtime and observability SDK for Vue 3, featuring SSE parsing, session state management, rendering optimization, and performance tracing.",
  "scripts": {
    "dev:web": "pnpm --filter @ai-runtime/playground dev",
    "typecheck:web": "pnpm --filter @ai-runtime/playground type-check",
    "dev:server": "pnpm --filter @ai-runtime/server dev",
    "typecheck:server": "pnpm --filter @ai-runtime/server type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck:web && pnpm typecheck:server"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoliu-coder/ai-streaming-runtime.git"
  },
  "keywords": [
    "ai",
    "llm",
    "streaming",
    "runtime",
    "observability",
    "vue",
    "typescript",
    "sse"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theoliu-coder/ai-streaming-runtime/issues"
  },
  "homepage": "https://github.com/theoliu-coder/ai-streaming-runtime#readme",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devDependencies": {
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "catalog:"
  }
}
